    }
   },
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(9, 3.2))\n",
    "\n",
    "p1 = tomato[tomato.Phase == \"P1\"]\n",
    "rate = p1.groupby(\"day\")[\"PlantHeight\"].apply(lambda s: s.isna().mean())\n",
    "axes[0].plot(rate.index, rate.values, marker=\"o\", color=\"#1baf7a\")\n",
    "axes[0].set_title(\"S3D missing rate, Phase 1\", fontsize=10)\n",
