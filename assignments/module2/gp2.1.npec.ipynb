    "    X_scaled = StandardScaler().fit_transform(X_imputed)\n",
    "    # TODO your code here\n",
    "    # return ... use PCA functionality to reduce X_scaled to n_components\n",
    "    raise NotImplementedError(\"Complete this exercise.\")\n",
    "\n",
    "\n",
    "toy = np.array([[0., 0.], [1., 1.], [2., np.nan], [3., 3.]])\n",
    "toy_z = pca_projection(toy, n_components=1)\n",
    "assert toy_z.shape == (4, 1)\n",
    "\n",
    "pca_coords = pca_projection(tomato[TRAIT_NAMES].to_numpy())\n",
    "assert pca_coords.shape == (len(tomato), 2)"
   ]
